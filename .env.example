# DEV ONLY. These credentials are throwaway values for local docker compose.
# Never reuse them anywhere else. Copy to .env (gitignored): cp .env.example .env

# Postgres superuser (dev only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=acl

# Keycloak database role (dev only), created by infra/postgres/init-keycloak-db.sh
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=dev-only-keycloak-db-password

# Keycloak bootstrap admin (dev only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password

# Database roles for the API (created by infra/postgres/init-app-roles.sh), dev only
CASEFILE_MIGRATOR_PASSWORD=dev-only-migrator-password
CASEFILE_APP_PASSWORD=dev-only-casefile-app-password
CASEFILE_WEB_DB_PASSWORD=dev-only-casefile-web-password
CASEFILE_AUDIT_PASSWORD=dev-only-casefile-audit-password
# the API connects as casefile_app; migrations as casefile_migrator; dev seed and DB tests setup as the superuser
DATABASE_URL=postgres://casefile_app:dev-only-casefile-app-password@127.0.0.1:5432/acl
MIGRATOR_DATABASE_URL=postgres://casefile_migrator:dev-only-migrator-password@127.0.0.1:5432/acl
ADMIN_DATABASE_URL=postgres://postgres:dev-only-postgres-password@127.0.0.1:5432/acl

# Casefile realm import (infra/keycloak/realm-casefile.json); all dev only, substituted by Keycloak at import
CASEFILE_WEB_SECRET=dev-only-casefile-web-client-secret
# password for every seeded dev user, must satisfy the realm password policy (length >= 14)
DEV_USER_PASSWORD=dev-only-Casefile-User-Pw-1
# TOTP key for seeded SECRET users (raw string; Keycloak uses its UTF-8 bytes as the HMAC key)
DEV_TOTP_SECRET=dev-only-totp-secret-0123

# API (apps/api) runtime config, all optional, defaults are strict. See docs/api-auth.md.
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/casefile
# CORS_ORIGINS=
# CLOCK_SKEW_SECONDS=5

# Web BFF (apps/web), dev only. See docs/bff.md.
WEB_ORIGIN=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3001
# session store role (created by the init script, sees only bff_sessions)
WEB_DATABASE_URL=postgres://casefile_web:dev-only-casefile-web-password@127.0.0.1:5432/acl
# AES-256-GCM key ring for tokens at rest: "id:base64(32 bytes)", first entry encrypts, all entries decrypt (rotation)
SESSION_ENCRYPTION_KEYS=dev-1:ZGV2LW9ubHktc2Vzc2lvbi1rZXktMDEyMzQ1Njc4OWE=
# false only for plain-http local development; true (default) gives __Host- cookies
COOKIE_SECURE=false
HSTS_ENABLED=false

# Audit chain (stage 7), dev only. See docs/audit.md.
# HMAC key ring: "id:base64(>=32 bytes)", first entry signs new rows, all entries verify old ones. API and web use the same ring.
AUDIT_HMAC_KEYS=audit-1:ZGV2LW9ubHktYXVkaXQtaG1hYy1rZXktMDEyMzQ1Njc=
# read-only verifier role (pnpm audit:verify)
AUDIT_DATABASE_URL=postgres://casefile_audit:dev-only-casefile-audit-password@127.0.0.1:5432/acl
AUDIT_CHECKPOINT_SECONDS=300

# Network zone (stage 8), dev only. See docs/hardening.md.
# Zone-signing ring "id:base64(>=32 bytes)": the BFF signs the client's network zone with it, the API believes a zone only when it verifies. Same ring in BFF and API.
ZONE_SIGNING_KEYS=zone-1:ZGV2LW9ubHktem9uZS1zaWduaW5nLWtleS0wMTIzNDU2
# Client networks counted as the managed zone (BFF only): comma separated IPs or CIDRs. Empty = nobody is managed.
# MANAGED_CIDRS=
# The reverse proxy in front of the BFF authenticates itself with this secret (>= 32 bytes) in x-acl-proxy-secret and sets x-acl-client-ip.
# Without it the BFF ignores every forwarded header and treats all clients as one address. Never set in dev unless testing the proxy path.
# TRUSTED_PROXY_SECRET=

# Profile (stage 8). ACL_ENV=production makes API and BFF refuse development values, weak or missing secrets, plain http and insecure cookies at startup.
# NODE_ENV is not the switch: `next start` sets it for every deployment, including the CI tests. Unset = development.
# ACL_ENV=production
# Every secret below can also be given as NAME_FILE=/path/to/file (container secrets): DATABASE_URL, AUDIT_DATABASE_URL, AUDIT_HMAC_KEYS,
# ZONE_SIGNING_KEYS, CASEFILE_WEB_SECRET, WEB_DATABASE_URL, SESSION_ENCRYPTION_KEYS, TRUSTED_PROXY_SECRET. Both forms at once is an error.
# API_HOST=127.0.0.1          # bind address of the API; 0.0.0.0 only inside a private container network
# API_INTERNAL_HTTP=true      # production only: allow plain http from the BFF to the API on a private network

# Attachments (stage 8). See docs/hardening.md section 4.
# ATTACHMENT_DIR=./data/attachments   # dedicated directory outside any web root (a volume in a deployment); created 0700, git-ignored in dev
# ATTACHMENT_MAX_BYTES=5242880        # 1 KiB to 25 MiB
# ATTACHMENT_SCANNER=none             # none: dev stub (clean; refuses to answer in production) | clamd
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
