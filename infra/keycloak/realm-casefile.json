{
  "realm": "casefile",
  "displayName": "Casefile Vault",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(14) and notUsername and passwordHistory(3) and notEmail",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessTokenLifespanForImplicitFlow": 900,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "browserFlow": "browser-casefile",
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer",
    "xRobotsTag": "none",
    "xFrameOptions": "DENY",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'none'; object-src 'none';",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "attributes": {
    "acr.loa.map": "{\"pwd\": \"1\", \"mfa\": \"2\"}"
  },
  "roles": {
    "realm": [
      {
        "name": "analyst",
        "description": "Reads and writes case files within clearance and compartments"
      },
      {
        "name": "reviewer",
        "description": "Reviews and approves case files, never own"
      },
      {
        "name": "unit-admin",
        "description": "Administers case files of own unit"
      },
      {
        "name": "auditor",
        "description": "Reads the audit log only"
      },
      {
        "name": "platform-admin",
        "description": "Platform operations, no implicit case access"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-casefile",
    "description": "Account self-service only",
    "composite": true,
    "composites": {
      "client": {
        "account": [
          "view-profile",
          "manage-account"
        ]
      }
    }
  },
  "authenticationFlows": [
    {
      "alias": "browser-casefile",
      "description": "Casefile browser flow: cookie or password; TOTP forced for SECRET clearance (independent of acr); TOTP on step-up request",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "casefile-forms"
        }
      ]
    },
    {
      "alias": "casefile-forms",
      "description": "",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "ref-pwd"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "casefile-otp-secret"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "casefile-level1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 40,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "casefile-level2"
        }
      ]
    },
    {
      "alias": "casefile-otp-secret",
      "description": "forced TOTP when clearance is SECRET; no LoA condition on purpose, so acr_values cannot skip it",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-attribute",
          "authenticatorConfig": "cond-is-secret"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "ref-otp"
        }
      ]
    },
    {
      "alias": "casefile-level1",
      "description": "records LoA 1 (password) for non-SECRET users",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-attribute",
          "authenticatorConfig": "cond-not-secret"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "cond-loa-1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "allow-access-authenticator"
        }
      ]
    },
    {
      "alias": "casefile-level2",
      "description": "LoA 2 (mfa): SECRET users already passed TOTP; others are asked for TOTP only when a client requests acr mfa",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "cond-loa-2"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "casefile-otp-stepup"
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "allow-access-authenticator"
        }
      ]
    },
    {
      "alias": "casefile-otp-stepup",
      "description": "TOTP step-up for non-SECRET users",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-attribute",
          "authenticatorConfig": "cond-not-secret-2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "ref-otp2"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "cond-is-secret",
      "config": {
        "attribute_name": "clearance",
        "attribute_expected_value": "SECRET",
        "not": "false"
      }
    },
    {
      "alias": "cond-not-secret",
      "config": {
        "attribute_name": "clearance",
        "attribute_expected_value": "SECRET",
        "not": "true"
      }
    },
    {
      "alias": "cond-not-secret-2",
      "config": {
        "attribute_name": "clearance",
        "attribute_expected_value": "SECRET",
        "not": "true"
      }
    },
    {
      "alias": "cond-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000",
        "loa-store-in-user-session": "true"
      }
    },
    {
      "alias": "cond-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000",
        "loa-store-in-user-session": "true"
      }
    },
    {
      "alias": "ref-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "ref-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "ref-otp2",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    }
  ],
  "clientScopeMappings": {
    "account": [
      {
        "client": "account-console",
        "roles": [
          "view-profile",
          "manage-account"
        ]
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "casefile-web",
      "roles": [
        "analyst",
        "reviewer",
        "unit-admin",
        "auditor",
        "platform-admin"
      ]
    }
  ],
  "clients": [
