# syntax=docker/dockerfile:1
# The reverse proxy, built from the Caddy release with a current Go toolchain and a patched golang.org/x/net: the stock caddy image carried
# Go standard library and x/net findings (HIGH, fix available) when this stage was written (docs/deployment.md). Standard modules only, no plugins.
FROM golang:1.26-alpine@sha256:27f2d3b83cfc5803c8078f8e730af0f7c431bf067afaec8f60a36fb763187cba AS build
ARG CADDY_VERSION=v2.11.7
WORKDIR /src
RUN go mod init caddybuild
COPY infra/caddy/main.go.txt main.go
RUN go get github.com/caddyserver/caddy/v2@${CADDY_VERSION} golang.org/x/net@v0.60.0 && go mod tidy \
 && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /caddy .

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
COPY --from=build /caddy /usr/bin/caddy
USER 65532:65532
ENTRYPOINT ["/usr/bin/caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile"]
