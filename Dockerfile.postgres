# syntax=docker/dockerfile:1
# The official postgres image plus the Alpine packages it still carries in vulnerable versions: brotli-libs 1.2.0-r1
# (CVE-2026-111497, HIGH, fixed in Alpine as 1.2.1-r0), libcurl 8.22.0-r0 (CVE-2026-92392, HIGH, fixed as 8.23.0-r0)
# and krb5-libs 1.22.2-r1 (19 HIGH CVEs, e.g. CVE-2026-107364, fixed as 1.22.3-r0)
# and libxslt 1.1.43-r3 (3 HIGH CVEs, e.g. CVE-2026-125350, fixed as 1.1.43-r4).
# Only those packages are upgraded, nothing else changes.
# Delete this file and use the official image again once upstream ships all the fixes (docs/supply-chain.md).
FROM postgres:18.6-alpine@sha256:898c60cb390d1085bc97bdd6a1ae968757421df394b071848b52b1c09c89d6a5
RUN apk add --no-cache --upgrade brotli-libs libcurl krb5-libs libxslt
