{
  "name": "access-control-lab",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "lint": "eslint . && node scripts/check-invisible-chars.mjs && node scripts/check-trivyignore.mjs",
    "typecheck": "pnpm --filter @acl/audit --filter @acl/netguard build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "test:identity": "pnpm --filter @acl/identity-tests test:identity",
    "test:db": "pnpm --filter @acl/api-db-tests test:db",
    "db:migrate": "pnpm --filter '@acl/api...' build && pnpm --filter @acl/api migrate",
    "db:seed": "pnpm --filter '@acl/api...' build && pnpm --filter @acl/api seed",
    "test:bff": "pnpm --filter '@acl/web...' build && pnpm --filter @acl/bff-tests test:bff",
    "audit:verify": "pnpm --filter '@acl/api...' build && pnpm --filter @acl/api audit:verify",
    "audit:checkpoint": "pnpm --filter '@acl/api...' build && pnpm --filter @acl/api audit:checkpoint"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
