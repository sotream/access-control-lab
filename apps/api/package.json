{
  "name": "@acl/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "migrate": "node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "seed": "node --env-file-if-exists=../../.env dist/db/seed-cli.js",
    "audit:verify": "node --env-file-if-exists=../../.env dist/audit/verify-cli.js",
    "audit:checkpoint": "node --env-file-if-exists=../../.env dist/audit/checkpoint-cli.js"
  },
  "dependencies": {
    "@acl/audit": "workspace:*",
    "@acl/netguard": "workspace:*",
    "@acl/policy": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
