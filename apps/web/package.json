{
  "name": "@acl/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "css": "node scripts/build-css.mjs",
    "predev": "pnpm css",
    "dev": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "prebuild": "pnpm css",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@acl/audit": "workspace:*",
    "@acl/netguard": "workspace:*",
    "next": "^16.4.2",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  }
}
