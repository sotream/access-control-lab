# syntax=docker/dockerfile:1
# Keycloak with the build step done at image build time ("optimized" image, https://www.keycloak.org/server/containers), so the container can
# run with a read-only root filesystem: `start --optimized` writes nothing under /opt/keycloak/lib.
FROM quay.io/keycloak/keycloak:26.8.1@sha256:3f3c5f8e03c614774b4bd9173b88391fefa4153bfc010d8012d59ad825377332 AS builder
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_FEATURES_DISABLED=device-flow,ciba,impersonation
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.8.1@sha256:3f3c5f8e03c614774b4bd9173b88391fefa4153bfc010d8012d59ad825377332
COPY --from=builder /opt/keycloak/ /opt/keycloak/
ENV KC_DB=postgres KC_HEALTH_ENABLED=true
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
